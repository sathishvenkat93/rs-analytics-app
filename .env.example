# RS Analytics: AI settings. Copy to .env and fill in. .env is git-ignored.
# These are read by the server only; they are never sent to the browser.

# bedrock = Claude in Amazon Bedrock | mock = offline heuristics for development | off = hide AI features
AI_PROVIDER=bedrock

# AWS region with Claude in Amazon Bedrock (bedrock-mantle endpoint)
AWS_REGION=us-east-1

# Model ID (Bedrock IDs carry the "anthropic." prefix). Enable access in the Bedrock console first.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# Used automatically if the main model declines a request. Leave empty to disable.
BEDROCK_FALLBACK_MODEL=anthropic.claude-opus-4-8

# Reasoning effort: low | medium | high | xhigh | max (medium is the model default)
BEDROCK_EFFORT=medium

# Credentials: set ONE of the options below (first match wins).
# 1) Amazon Bedrock API key (bearer token)
# AWS_BEARER_TOKEN_BEDROCK=
# 2) IAM access keys (temporary credentials recommended)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# 3) A named profile from ~/.aws/credentials or SSO
# AWS_PROFILE=
# 4) Leave all unset to use the default AWS credential chain (instance role, SSO, etc.)

# Port for `npm start` (production server)
# PORT=8787
